
class Solution {

    int[] parent;

    public int[] findRedundantDirectedConnection(int[][] edges) {

        int n = edges.length;

        // Step 1: Check if any node has two parents
        int[] parentNode = new int[n + 1];

        int[] edge1 = null;
        int[] edge2 = null;

        for (int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];

            if (parentNode[v] == 0) {
                parentNode[v] = u;
            } else {
                // Two parents found
                edge1 = new int[]{parentNode[v], v};
                edge2 = edge;
                break;
            }
        }

        // Step 2: Initialize DSU
        parent = new int[n + 1];

        for (int i = 1; i <= n; i++) {
            parent[i] = i;
        }

        // Step 3: Process edges and detect cycle
        for (int[] edge : edges) {

            // Ignore the second conflicting edge
            if (edge == edge2) {
                continue;
            }

            int u = edge[0];
            int v = edge[1];

            if (find(u) == find(v)) {

                // Case 3: Two parents + cycle
                if (edge1 != null) {
                    return edge1;
                }

                // Case 1: Only cycle
                return edge;
            }

            union(u, v);
        }

        // Case 2: Two parents, no cycle
        return edge2;
    }

    private int find(int x) {
        if (parent[x] != x) {
            parent[x] = find(parent[x]);
        }
        return parent[x];
    }

    private void union(int x, int y) {
        int px = find(x);
        int py = find(y);

        if (px != py) {
            parent[py] = px;
        }
    }
}
